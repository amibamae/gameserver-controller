{
  "policy_id": "supervised-pilot-vm-capacity",
  "cases": [
    {
      "id": "production-slot-available-for-explicit-management",
      "request_action": "adopt",
      "request_environment": "production",
      "existing_instances": [],
      "expected": {"allowed": true, "reason": "slot_available"}
    },
    {
      "id": "staging-slot-available",
      "request_action": "create",
      "request_environment": "staging",
      "existing_instances": [],
      "expected": {"allowed": true, "reason": "slot_available"}
    },
    {
      "id": "testing-slot-available",
      "request_action": "create",
      "request_environment": "testing",
      "existing_instances": [],
      "expected": {"allowed": true, "reason": "slot_available"}
    },
    {
      "id": "production-and-shared-nonproduction-slots-allow-two-managed-vms",
      "request_action": "create",
      "request_environment": "staging",
      "existing_instances": [
        {"environment": "production", "provider_state": "running", "managed": true}
      ],
      "expected": {"allowed": true, "reason": "slot_available"}
    },
    {
      "id": "unmanaged-live-production-does-not-use-managed-slot",
      "request_action": "create",
      "request_environment": "production",
      "existing_instances": [
        {"environment": "production", "provider_state": "running", "managed": false},
        {"environment": "staging", "provider_state": "running", "managed": true}
      ],
      "expected": {"allowed": true, "reason": "slot_available"}
    },
    {
      "id": "occupied-production-group-slot-denied",
      "request_action": "adopt",
      "request_environment": "production",
      "existing_instances": [
        {"environment": "production", "provider_state": "running", "managed": true}
      ],
      "expected": {"allowed": false, "reason": "capacity_reached"}
    },
    {
      "id": "third-managed-vm-is-blocked-after-both-groups-are-full",
      "request_action": "create",
      "request_environment": "testing",
      "existing_instances": [
        {"environment": "production", "provider_state": "running", "managed": true},
        {"environment": "staging", "provider_state": "running", "managed": true}
      ],
      "expected": {"allowed": false, "reason": "capacity_reached"}
    },
    {
      "id": "staging-and-testing-share-one-managed-slot",
      "request_action": "adopt",
      "request_environment": "testing",
      "existing_instances": [
        {"environment": "staging", "provider_state": "running", "managed": true}
      ],
      "expected": {"allowed": false, "reason": "capacity_reached"}
    },
    {
      "id": "pending-managed-reservation-counts-as-capacity",
      "request_action": "create",
      "request_environment": "production",
      "existing_instances": [
        {"environment": "production", "provider_state": "reserved", "managed": true}
      ],
      "expected": {"allowed": false, "reason": "capacity_reached"}
    },
    {
      "id": "unresolved-managed-create-keeps-capacity",
      "request_action": "create",
      "request_environment": "testing",
      "existing_instances": [
        {"environment": "staging", "provider_state": "create_outcome_unknown", "managed": true}
      ],
      "expected": {"allowed": false, "reason": "capacity_reached"}
    },
    {
      "id": "unresolved-managed-destroy-keeps-capacity",
      "request_action": "create",
      "request_environment": "production",
      "existing_instances": [
        {"environment": "production", "provider_state": "destroy_outcome_unknown", "managed": true}
      ],
      "expected": {"allowed": false, "reason": "capacity_reached"}
    },
    {
      "id": "already-over-limit-denies-another-managed-vm",
      "request_action": "create",
      "request_environment": "testing",
      "existing_instances": [
        {"environment": "production", "provider_state": "running", "managed": true},
        {"environment": "staging", "provider_state": "running", "managed": true}
      ],
      "expected": {"allowed": false, "reason": "capacity_reached"}
    },
    {
      "id": "provider-confirmed-absence-releases-managed-capacity",
      "request_action": "create",
      "request_environment": "production",
      "existing_instances": [
        {"environment": "production", "provider_state": "absent", "managed": true}
      ],
      "expected": {"allowed": true, "reason": "slot_available"}
    },
    {
      "id": "provider-confirmed-destruction-releases-managed-capacity",
      "request_action": "create",
      "request_environment": "testing",
      "existing_instances": [
        {"environment": "staging", "provider_state": "destroyed", "managed": true}
      ],
      "expected": {"allowed": true, "reason": "slot_available"}
    },
    {
      "id": "unsupported-environment-denied",
      "request_action": "create",
      "request_environment": "development",

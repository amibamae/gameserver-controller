{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.19.0-draft:game:migrate-input",
  "title": "Game data migration input",
  "description": "Apply an approved, compatibility-required data migration from a verified backup to a distinct target instance and exact immutable release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "source_backup",
    "compatibility_result",
    "target",
    "target_release",
    "object_streams",
    "required_check_ids"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Controller-validated approval reference bound to this exact backup, target, release, and check set."
    },
    "source_backup": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:operations:server-backup-result"
    },
    "compatibility_result": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:game:compatibility-check-output"
    },
    "target": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:game:game-instance-target"
    },
    "target_release": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:game:release-describe-output"
    },
    "object_streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "description": "One bounded controller-to-adapter stream for every exact object in the verified source backup manifest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_ref",
          "transfer_ref"
        ],
        "properties": {
          "object_ref": {
            "$ref": "urn:gameserver-controller:0.19.0-draft:storage:storage-object-reference"
          },
          "transfer_ref": {
            "allOf": [
              {
                "$ref": "urn:gameserver-controller:0.19.0-draft:storage:storage-transfer-reference"
              },
              {
                "properties": {
                  "direction": {
                    "const": "controller_to_adapter"
                  }
                },
                "required": [
                  "direction"
                ]
              }
            ]
          }
        }
      }
    },
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    }
  }
}

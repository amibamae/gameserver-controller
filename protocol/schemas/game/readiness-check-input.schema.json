{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:game:readiness-check-input",
  "title": "Game readiness check input",
  "description": "Evaluate the required game-specific checks against one exact server, environment, instance, and pinned game release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server_id",
    "environment_id",
    "instance_ref",
    "game_release_id",
    "readiness_check_set_id",
    "required_checks"
  ],
  "properties": {
    "server_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "instance_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "game_release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "readiness_check_set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "check_version"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "check_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:game:backup-capture-output",
  "title": "Game backup capture output",
  "description": "Capture status and independently checkable metadata for one exact prepared data set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "release_id",
    "backup_id",
    "data_generation_id",
    "preparation_id",
    "data_set_id",
    "capture_id",
    "consistency_mode",
    "outcome",
    "observed_at"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:game:game-instance-target"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "data_generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "preparation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "data_set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "consistency_mode": {
      "enum": [
        "offline",
        "game_native"
      ]
    },
    "outcome": {
      "enum": [
        "captured",
        "rejected",
        "outcome_unknown"
      ],
      "description": "rejected means the capture side effect definitively did not occur; outcome_unknown means it may have occurred and requires reconciliation. The controller trusts either claim only when the result schema and exact request binding are valid."
    },
    "stream_completed": {
      "type": "boolean",
      "description": "True only after the adapter has closed the complete data-set stream without truncation. The controller still verifies actual byte count and checksum."
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checksum": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:storage:storage-checksum"
    },
    "write_watermark": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:game:backup-write-watermark"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "reconciliation_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "captured"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "stream_completed",
          "size_bytes",
          "checksum"
        ],
        "properties": {
          "stream_completed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reason_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reconciliation_ref"
        ]
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.5.0-draft:game:release-describe-output",
  "title": "Game release description",
  "description": "Pinned game release metadata, artifact integrity digests, runtime requirements, configuration schema identity, data format, and execution capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game_adapter_id",
    "game_name",
    "release_id",
    "game_version",
    "targets",
    "artifacts",
    "runtime_requirements",
    "configuration_schema_uri",
    "configuration_schema_checksum",
    "data_format",
    "required_execution_capabilities"
  ],
  "properties": {
    "game_adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^game\\.[a-z][a-z0-9.-]*$"
    },
    "game_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "game_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque game-defined version. The controller MUST NOT compare versions unless the adapter defines comparison semantics."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os_family",
          "architecture"
        ],
        "properties": {
          "os_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "architecture": {
            "enum": [
              "x86_64",
              "aarch64",
              "arm64",
              "other"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_uri",
          "checksum"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "artifact_uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "checksum": {
            "$ref": "urn:gameserver-controller:0.5.0-draft:storage:storage-checksum"
          }
        }
      }
    },
    "runtime_requirements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_id",
          "version_requirement"
        ],
        "properties": {
          "runtime_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "version_requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "configuration_schema_uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "configuration_schema_checksum": {
      "$ref": "urn:gameserver-controller:0.5.0-draft:storage:storage-checksum"
    },
    "data_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_id",
        "version"
      ],
      "properties": {
        "format_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "required_execution_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.17.0-draft:game:health-check-input",
  "title": "Game health check input",
  "description": "Evaluate selected game-specific health checks against one exact server, environment, instance, and release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server_id",
    "environment_id",
    "instance_ref",
    "game_release_id",
    "required_check_ids"
  ],
  "properties": {
    "server_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "instance_ref": {
      "$ref": "urn:gameserver-controller:0.17.0-draft:common:external-resource-ref"
    },
    "game_release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    }
  }
}

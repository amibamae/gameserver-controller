{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.17.0-draft:game:backup-validate-output",
  "title": "Game backup validation output",
  "description": "Unknown validation is not valid; `valid` requires all requested game-specific checks to pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backup_id",
    "environment_id",
    "data_generation_id",
    "validation_result",
    "observed_at",
    "check_results"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "data_generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "validation_result": {
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "check_version",
          "result",
          "observed_at"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "check_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "safe_diagnostics": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}

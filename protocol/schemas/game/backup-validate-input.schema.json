{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:game:backup-validate-input",
  "title": "Game backup validation input",
  "description": "Validate game-specific backup structure using bounded, operation-scoped streams for the exact manifest objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backup_id",
    "environment_id",
    "manifest",
    "object_streams",
    "required_check_ids"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "manifest": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:storage:backup-manifest"
    },
    "object_streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_ref"],
        "properties": {
          "object_ref": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:storage:storage-object-reference"
          }
        }
      }
    },
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.11.0-draft:game:backup-validate-input",
  "title": "Game backup validation input",
  "description": "Validate game-specific backup structure using bounded, operation-scoped streams for the exact manifest objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backup_id",
    "environment_id",
    "manifest",
    "object_streams",
    "required_check_ids"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "manifest": {
      "$ref": "urn:gameserver-controller:0.11.0-draft:storage:backup-manifest"
    },
    "object_streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_ref",
          "transfer_ref"
        ],
        "properties": {
          "object_ref": {
            "$ref": "urn:gameserver-controller:0.11.0-draft:storage:storage-object-reference"
          },
          "transfer_ref": {
            "allOf": [
              {
                "$ref": "urn:gameserver-controller:0.11.0-draft:storage:storage-transfer-reference"
              },
              {
                "properties": {
                  "direction": {
                    "const": "controller_to_adapter"
                  }
                },
                "required": [
                  "direction"
                ]
              }
            ]
          }
        }
      }
    },
    "required_check_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._-]*$"
      }
    }
  }
}

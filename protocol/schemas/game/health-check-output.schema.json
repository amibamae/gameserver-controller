{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.14.0-draft:game:health-check-output",
  "title": "Game health check output",
  "description": "Health is derived from exactly one result per requested check; unknown evidence cannot be reported as healthy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server_id",
    "environment_id",
    "instance_ref",
    "game_release_id",
    "health",
    "diagnostics_redacted",
    "observed_at",
    "check_results"
  ],
  "properties": {
    "server_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "instance_ref": {
      "$ref": "urn:gameserver-controller:0.14.0-draft:common:external-resource-ref"
    },
    "game_release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "health": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown"
      ]
    },
    "diagnostics_redacted": {
      "const": true
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "safe_diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "check_version",
          "result",
          "observed_at"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "check_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "result": {
            "enum": [
              "pass",
              "warn",
              "fail",
              "unknown"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        }
      }
    }
  }
}

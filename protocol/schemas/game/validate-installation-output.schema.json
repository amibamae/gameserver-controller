{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.12.0-draft:game:validate-installation-output",
  "title": "Game validate installation output",
  "description": "Per-artifact installation observations. Unknown or incomplete validation does not authorize start or readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "release_id",
    "validation_result",
    "artifact_results",
    "observed_at"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.12.0-draft:game:game-instance-target"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "validation_result": {
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ]
    },
    "artifact_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "result"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "result": {
            "enum": [
              "verified",
              "mismatch",
              "unavailable",
              "unknown"
            ]
          },
          "expected_checksum": {
            "$ref": "urn:gameserver-controller:0.12.0-draft:storage:storage-checksum"
          },
          "observed_checksum": {
            "$ref": "urn:gameserver-controller:0.12.0-draft:storage:storage-checksum"
          }
        }
      }
    },
    "observed_game_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

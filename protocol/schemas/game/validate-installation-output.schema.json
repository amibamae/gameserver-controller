{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:game:validate-installation-output",
  "title": "Game validate installation output",
  "description": "Per-artifact installation observations. Unknown or incomplete validation does not authorize start or readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "release_id",
    "validation_result",
    "artifact_results",
    "observed_at"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:game:game-instance-target"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "validation_result": {
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ]
    },
    "artifact_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "urn:gameserver-controller:0.21.0-draft:game:artifact-verification"
      }
    },
    "observed_game_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation_result": {
            "const": "valid"
          }
        },
        "required": [
          "validation_result"
        ]
      },
      "then": {
        "properties": {
          "artifact_results": {
            "items": {
              "properties": {
                "result": {
                  "const": "verified"
                }
              },
              "required": [
                "result"
              ]
            }
          }
        }
      }
    }
  ]
}

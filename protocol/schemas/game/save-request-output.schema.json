{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.19.0-draft:game:save-request-output",
  "title": "Game save request output",
  "description": "`confirmed` means the game-native save or flush completed; accepted or unknown outcomes are never proof of a saved world.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "release_id",
    "outcome",
    "observed_at"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:game:game-instance-target"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "outcome": {
      "enum": [
        "confirmed",
        "rejected",
        "outcome_unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "reconciliation_ref": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:common:external-resource-ref"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "confirmed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "saved_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reason_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "reconciliation_ref"
        ]
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.20.0-draft:operations:operation-request",
  "title": "Standard management operation request",
  "description": "Generic reference schema. The management API uses the more specific oneOf schema in its OpenAPI document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_type", "parameters"],
  "properties": {
    "operation_type": {
      "enum": ["server.define", "server.provision", "server.start", "server.stop", "server.backup", "server.restore", "server.destroy"]
    },
    "parameters": {"type": "object"},
    "deadline": {"type": "string", "format": "date-time"}
  },
  "oneOf": [
    {"properties": {"operation_type": {"const": "server.define"}, "parameters": {"$ref": "urn:gameserver-controller:0.20.0-draft:operations:server-definition"}}},
    {"properties": {"operation_type": {"const": "server.provision"}, "parameters": {"$ref": "urn:gameserver-controller:0.20.0-draft:hosting:provision-request"}}},
    {"properties": {"operation_type": {"const": "server.start"}, "parameters": {"$ref": "urn:gameserver-controller:0.20.0-draft:operations:start-parameters"}}},
    {"properties": {"operation_type": {"const": "server.stop"}, "parameters": {"$ref": "urn:gameserver-controller:0.20.0-draft:operations:stop-parameters"}}},
    {"properties": {"operation_type": {"const": "server.backup"}, "parameters": {"$ref": "urn:gameserver-controller:0.20.0-draft:operations:backup-parameters"}}},
    {"properties": {"operation_type": {"const": "server.restore"}, "parameters": {"$ref": "urn:gameserver-controller:0.20.0-draft:operations:restore-parameters"}}},
    {"properties": {"operation_type": {"const": "server.destroy"}, "parameters": {"$ref": "urn:gameserver-controller:0.20.0-draft:operations:destroy-parameters"}}}
  ]
}
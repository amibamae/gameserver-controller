{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.10.0-draft:operations:operation-event",
  "title": "Operation event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "operation_id", "sequence", "event_type", "timestamp"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 160},
    "timestamp": {"type": "string", "format": "date-time"},
    "step_id": {"type": "string", "maxLength": 200},
    "status": {"enum": ["pending", "running", "waiting", "cancellation_requested", "reconciling", "needs_operator", "succeeded", "failed", "cancelled"]},
    "data": {"type": "object"}
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:operations:operation",
  "title": "Durable operation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "operation_id",
    "operation_type",
    "protocol_version",
    "target",
    "status",
    "actor_id",
    "request_snapshot",
    "created_at",
    "updated_at",
    "steps"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.]+$"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "environment_id"
      ],
      "properties": {
        "server_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "instance_ref": {
          "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
        }
      }
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "waiting",
        "cancellation_requested",
        "reconciling",
        "needs_operator",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "current_step_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]{1,128}$"
    },
    "request_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$",
      "description": "Fingerprint of the accepted management request parameters for idempotency; adapter reconciliation fingerprints the durable capability input separately."
    },
    "request_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_type",
        "parameters"
      ],
      "description": "Immutable validated request snapshot. Parameters MUST conform to the operation-specific request schema and MUST NOT contain resolved secret values.",
      "properties": {
        "operation_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "parameters": {
          "type": "object",
          "description": "Validated operation parameters with secret values removed."
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:common:secret-reference"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "step_type",
          "status"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "step_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "waiting",
              "outcome_unknown",
              "succeeded",
              "failed",
              "skipped",
              "cancelled"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "adapter_id": {
            "type": "string",
            "maxLength": 160
          },
          "input": {
            "type": "object",
            "description": "Immutable adapter input template. When input_bindings are present, the template may omit those target fields. Secret values MUST remain references."
          },
          "input_bindings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_pointer", "source_step_id", "source_pointer"],
              "properties": {
                "target_pointer": {"type": "string", "minLength": 1, "maxLength": 1024},
                "source_step_id": {"type": "string", "minLength": 1, "maxLength": 200},
                "source_pointer": {"type": "string", "maxLength": 1024}
              }
            },
            "description": "Immutable bindings from outputs of earlier steps. Target JSON Pointer paths MUST be absent in input and MUST NOT overlap."
          },
          "resolved_input": {
            "type": "object",
            "description": "The fully materialized input, validated against the exact capability schema and durably persisted before dispatch. Immutable after it is set."
          },
          "output": {
            "type": "object",
            "description": "Schema-validated adapter output recorded after a definitive completed outcome."
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "external_operation_ref": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref",
            "description": "Normalized reference retained for an accepted or uncertain external effect. For an outcome_unknown adapter response, the controller copies the capability output's reconciliation_ref or external_operation_ref here; it does not persist the transient output."
          },
          "error": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:common:protocol-error"
          },
          "capability_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9.]+$"
          },
          "capability_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "description": "One closed durable step object. Adapter-invoking steps record the exact capability identity and version used.",
        "allOf": [
          {
            "if": {
              "required": [
                "capability_name"
              ]
            },
            "then": {
              "required": [
                "adapter_id",
                "capability_version",
                "input"
              ]
            }
          },
          {
            "if": {"required": ["input_bindings"]},
            "then": {
              "required": ["capability_name", "input"],
              "properties": {"input_bindings": {"minItems": 1}}
            }
          },
          {
            "if": {"required": ["resolved_input"]},
            "then": {"required": ["input_bindings"]}
          },
          {
            "if": {
              "required": ["input_bindings", "status"],
              "properties": {"status": {"enum": ["running", "waiting", "outcome_unknown", "succeeded"]}}
            },
            "then": {"required": ["resolved_input"]}
          },
          {
            "if": {
              "required": [
                "capability_version"
              ]
            },
            "then": {
              "required": [
                "adapter_id",
                "capability_name"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "succeeded"
                }
              },
              "required": [
                "status",
                "capability_name"
              ]
            },
            "then": {
              "required": [
                "output"
              ]
            }
          }
        ]
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "$ref": "urn:gameserver-controller:0.21.0-draft:operations:operation-result"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:protocol-error"
    },
    "schema_package_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Optional immutable identifier for the exact schema/specification package used to accept this operation, such as a release tag or content digest."
    },
    "backup_initial_lifecycle_state": {
      "type": "string",
      "enum": [
        "ready",
        "degraded",
        "stopped"
      ],
      "description": "Core-owned immutable lifecycle state captured for server.backup immediately before its first backup-related lifecycle transition or adapter dispatch. It is not request or adapter data."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completed_at",
          "result"
        ],
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:operation-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completed_at",
          "error"
        ],
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completed_at"
        ],
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.provision"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:server-provision-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:server-backup-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.restore"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:server-restore-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.destroy"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:server-destroy-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.define"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:server-define-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.start"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:server-start-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.stop"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:operations:server-stop-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.restore"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "if": {
          "properties": {
            "request_snapshot": {
              "properties": {
                "parameters": {
                  "properties": {
                    "start_after_restore": {
                      "const": true
                    }
                  },
                  "required": [
                    "start_after_restore"
                  ]
                }
              },
              "required": [
                "parameters"
              ]
            }
          },
          "required": [
            "request_snapshot"
          ]
        },
        "then": {
          "properties": {
            "result": {
              "properties": {
                "operation_data": {
                  "properties": {
                    "final_lifecycle_state": {
                      "const": "ready"
                    }
                  }
                }
              }
            }
          }
        },
        "else": {
          "properties": {
            "result": {
              "properties": {
                "operation_data": {
                  "properties": {
                    "final_lifecycle_state": {
                      "const": "stopped"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "request_snapshot": {
            "properties": {
              "parameters": {
                "properties": {
                  "resume_after_backup": {
                    "const": false
                  }
                },
                "required": [
                  "resume_after_backup"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "operation_type",
          "status",
          "request_snapshot"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "stopped"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "operation_type",
          "status"
        ]
      },
      "then": {
        "required": [
          "backup_initial_lifecycle_state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "backup_initial_lifecycle_state": {
            "const": "stopped"
          }
        },
        "required": [
          "operation_type",
          "status",
          "backup_initial_lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "stopped"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "backup_initial_lifecycle_state": {
            "const": "ready"
          },
          "request_snapshot": {
            "properties": {
              "parameters": {
                "properties": {
                  "resume_after_backup": {
                    "const": false
                  }
                },
                "required": [
                  "resume_after_backup"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "operation_type",
          "status",
          "backup_initial_lifecycle_state",
          "request_snapshot"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "stopped"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "backup_initial_lifecycle_state": {
            "const": "ready"
          },
          "request_snapshot": {
            "properties": {
              "parameters": {
                "properties": {
                  "resume_after_backup": {
                    "const": true
                  }
                },
                "required": [
                  "resume_after_backup"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "operation_type",
          "status",
          "backup_initial_lifecycle_state",
          "request_snapshot"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "ready"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "backup_initial_lifecycle_state": {
            "const": "degraded"
          },
          "request_snapshot": {
            "properties": {
              "parameters": {
                "properties": {
                  "resume_after_backup": {
                    "const": false
                  }
                },
                "required": [
                  "resume_after_backup"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "operation_type",
          "status",
          "backup_initial_lifecycle_state",
          "request_snapshot"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "stopped"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "backup_initial_lifecycle_state": {
            "const": "degraded"
          },
          "request_snapshot": {
            "properties": {
              "parameters": {
                "properties": {
                  "resume_after_backup": {
                    "const": true
                  }
                },
                "required": [
                  "resume_after_backup"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "operation_type",
          "status",
          "backup_initial_lifecycle_state",
          "request_snapshot"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "ready"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "backup_initial_lifecycle_state": {
            "const": "ready"
          },
          "request_snapshot": {
            "properties": {
              "parameters": {
                "not": {
                  "required": [
                    "resume_after_backup"
                  ]
                }
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "operation_type",
          "status",
          "backup_initial_lifecycle_state",
          "request_snapshot"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "ready"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.backup"
          },
          "status": {
            "const": "succeeded"
          },
          "backup_initial_lifecycle_state": {
            "const": "degraded"
          },
          "request_snapshot": {
            "properties": {
              "parameters": {
                "not": {
                  "required": [
                    "resume_after_backup"
                  ]
                }
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        "required": [
          "operation_type",
          "status",
          "backup_initial_lifecycle_state",
          "request_snapshot"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "operation_data": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "stopped"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {
            "const": "server.define"
          }
        },
        "required": [
          "operation_type"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.1.0-draft:operations:server-backup-result",
  "title": "Durable server.backup operation result",
  "description": "Canonical operation result with typed data for server.backup.",
  "allOf": [
    {
      "$ref": "urn:gameserver-controller:0.1.0-draft:operations:operation-result"
    },
    {
      "type": "object",
      "required": [
        "operation_type",
        "operation_data"
      ],
      "properties": {
        "operation_type": {
          "const": "server.backup"
        },
        "operation_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backup_id",
            "environment_id",
            "data_generation_id",
            "manifest",
            "verified_at",
            "final_lifecycle_state"
          ],
          "properties": {
            "backup_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "environment_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "data_generation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "manifest": {
              "$ref": "urn:gameserver-controller:0.1.0-draft:storage:backup-manifest"
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "final_lifecycle_state": {
              "enum": [
                "ready",
                "stopped"
              ]
            },
            "readiness_assertion": {
              "$ref": "urn:gameserver-controller:0.1.0-draft:lifecycle:readiness-assertion"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "final_lifecycle_state": {
                    "const": "ready"
                  }
                },
                "required": [
                  "final_lifecycle_state"
                ]
              },
              "then": {
                "required": [
                  "readiness_assertion"
                ]
              }
            }
          ]
        }
      }
    }
  ]
}

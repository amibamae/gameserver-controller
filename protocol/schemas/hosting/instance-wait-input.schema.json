{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:hosting:instance-wait-input",
  "title": "Hosting instance wait input",
  "description": "Wait for one exact instance to reach the expected state. A provider operation reference may be supplied when available. The wait deadline bounds this request and does not cancel provider work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_ref",
    "expected_state",
    "wait_timeout_seconds"
  ],
  "properties": {
    "instance_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "provider_operation_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "expected_state": {
      "enum": [
        "active",
        "stopped",
        "destroyed"
      ]
    },
    "wait_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.15.0-draft:hosting:os-offerings-list-output",
  "title": "Hosting OS offerings list output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "os_offerings",
    "observed_at"
  ],
  "properties": {
    "os_offerings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offering_id",
          "region_id",
          "os_family",
          "name",
          "version",
          "architecture",
          "availability"
        ],
        "properties": {
          "offering_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "region_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "os_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "architecture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "availability": {
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ]
          }
        }
      }
    },
    "next_page_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

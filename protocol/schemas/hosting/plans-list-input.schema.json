{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.15.0-draft:hosting:plans-list-input",
  "title": "Hosting plan list input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "region_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "minimum_vcpu_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "minimum_memory_mib": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "page_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Opaque continuation token bound to this filter set."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:hosting:provision-request",
  "title": "Provider-neutral provision request",
  "type": "object",
  "additionalProperties": false,
  "required": ["server_id", "environment_id", "hosting_adapter_id", "region_id", "plan_id", "os", "bootstrap", "game", "execution"],
  "properties": {
    "server_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "environment_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "hosting_adapter_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "region_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "os": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_os_id", "distribution", "version", "architecture"],
      "properties": {
        "provider_os_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "distribution": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "architecture": {"enum": ["x86_64", "aarch64", "arm64", "other"]}
      }
    },
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["source_uri", "revision", "digest"],
      "properties": {
        "source_uri": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 200},
        "digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "inputs": {"type": "object", "description": "Non-secret bootstrap configuration only. Credential material MUST be supplied through top-level secret_refs and a protected resolution channel."}
      }
    },
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "release_ref"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "release_ref": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "profile"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "profile": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "restore_backup_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "network_profile": {"type": "string", "maxLength": 200},
    "firewall_policy_ref": {"type": "string", "maxLength": 500},
    "secret_refs": {
      "type": "array",
      "items": {"$ref": "urn:gameserver-controller:0.21.0-draft:common:secret-reference"}
    },
    "ssh_key_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "labels": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 500}}
  }
}
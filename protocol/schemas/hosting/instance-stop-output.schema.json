{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.19.0-draft:hosting:instance-stop-output",
  "title": "Hosting instance stop output",
  "description": "A completed stop confirms the resulting provider state for the exact instance. Accepted and unknown outcomes are distinct from completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_ref",
    "outcome",
    "state",
    "observed_at"
  ],
  "properties": {
    "instance_ref": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:common:external-resource-ref"
    },
    "outcome": {
      "enum": [
        "completed",
        "accepted",
        "outcome_unknown"
      ]
    },
    "state": {
      "enum": [
        "stopped",
        "active",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_operation_ref": {
      "$ref": "urn:gameserver-controller:0.19.0-draft:common:external-resource-ref"
    },
    "safe_diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "stopped"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "accepted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "active"
          }
        },
        "required": [
          "provider_operation_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "unknown"
          }
        }
      }
    }
  ]
}

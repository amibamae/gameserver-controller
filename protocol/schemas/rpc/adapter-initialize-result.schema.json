{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.14.0-draft:rpc:adapter-initialize-result",
  "title": "Adapter initialize JSON-RPC result",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_protocol_version", "session_id"],
      "properties": {
        "selected_protocol_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
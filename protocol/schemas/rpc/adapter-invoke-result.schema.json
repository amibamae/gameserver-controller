{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.14.0-draft:rpc:adapter-invoke-result",
  "title": "Adapter invoke JSON-RPC result",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "output", "observed_at"],
      "properties": {
        "outcome": {"enum": ["completed", "accepted", "outcome_unknown"]},
        "external_operation_ref": {"$ref": "urn:gameserver-controller:0.14.0-draft:common:external-resource-ref"},
        "output": {"type": "object"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.8.0-draft:rpc:adapter-invoke-request",
  "title": "Adapter invoke JSON-RPC request",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "method", "params"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "method": {"const": "adapter.invoke"},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "capability", "request_context", "input"],
      "properties": {
        "protocol_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "capability": {"type": "string", "minLength": 1, "maxLength": 160},
        "request_context": {"$ref": "urn:gameserver-controller:0.8.0-draft:common:request-context"},
        "input": {"type": "object"}
      }
    }
  }
}
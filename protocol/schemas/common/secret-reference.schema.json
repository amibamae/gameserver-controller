{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:common:secret-reference",
  "title": "Secret reference",
  "description": "Opaque pointer to protected secret material. This object is not the secret and does not grant permission to resolve it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["secret_ref", "purpose"],
  "properties": {
    "secret_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[a-z][a-z0-9+.-]*://"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "permission_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "version_ref": {
      "type": "string",
      "maxLength": 500
    }
  }
}
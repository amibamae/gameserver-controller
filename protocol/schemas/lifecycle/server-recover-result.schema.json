{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:lifecycle:server-recover-result",
  "title": "Server recovery operation result",
  "type": "object",
  "description": "Result of a server recovery operation, including any necessary state transitions and next steps.",
  "properties": {
    "recovery_outcome": {
      "description": "Outcome of the recovery attempt.",
      "enum": [
        "success",
        "failed",
        "pending_external_action"
      ]
    },
    "final_lifecycle_state": {
      "description": "New lifecycle state after recovery attempt.",
      "type": ["string", "null"],
      "enum": [
        "unprovisioned",
        "provisioning",
        "preparing",
        "restoring",
        "starting",
        "validating",
        "ready",
        "degraded",
        "draining",
        "stopping",
        "backing_up",
        "stopped",
        "destroying",
        "destroyed",
        "failed"
      ]
    },
    "next_action": {
      "description": "Recommended next action or null if no further action required.",
      "type": ["string", "null"],
      "enum": [
        "none",
        "retry_recovery",
        "manual_intervention",
        "destroy_if_no_backup"
      ]
    },
    "operation_id": {
      "description": "Operation ID for durable tracking.",
      "type": "string",
      "maxLength": 200
    },
    "recovered_at": {
      "description": "When recovery completed.",
      "type": "string",
      "format": "date-time"
    },
    "recovery_steps": {
      "description": "Recovery steps performed during this operation.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {"type": "string"},
          "success": {"type": "boolean"},
          "message": {"type": "string"}
        }
      }
    },
    "warnings": {
      "description": "Warnings or notes about the recovery outcome.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "external_operation_ref": {
      "description": "Reference to external operation tracking (if applicable).",
      "type": ["string", "null"],
      "maxLength": 200
    }
  }
}

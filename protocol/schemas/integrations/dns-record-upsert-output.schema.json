{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:integrations:dns-record-upsert-output",
  "title": "DNS record upsert output",
  "description": "Request acceptance is distinct from the provider's observed record state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record",
    "request_outcome",
    "observation_state",
    "observed_at"
  ],
  "properties": {
    "record": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:integrations:dns-record-target"
    },
    "request_outcome": {
      "enum": [
        "confirmed",
        "accepted",
        "rejected",
        "outcome_unknown"
      ]
    },
    "observation_state": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 45,
        "anyOf": [
          {
            "format": "ipv4"
          },
          {
            "format": "ipv6"
          }
        ]
      }
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation_state": {
            "const": "present"
          }
        },
        "required": [
          "observation_state"
        ]
      },
      "then": {
        "required": [
          "values",
          "ttl_seconds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "observation_state": {
            "enum": [
              "absent",
              "unknown"
            ]
          }
        },
        "required": [
          "observation_state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "ttl_seconds"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_outcome": {
            "const": "confirmed"
          }
        },
        "required": [
          "request_outcome"
        ]
      },
      "then": {
        "properties": {
          "observation_state": {
            "const": "present"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_outcome": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "request_outcome"
        ]
      },
      "then": {
        "properties": {
          "observation_state": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record": {
            "properties": {
              "record_type": {
                "const": "A"
              }
            },
            "required": [
              "record_type"
            ]
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "properties": {
          "values": {
            "items": {
              "format": "ipv4"
            }
          },
          "expected_values": {
            "items": {
              "format": "ipv4"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record": {
            "properties": {
              "record_type": {
                "const": "AAAA"
              }
            },
            "required": [
              "record_type"
            ]
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "properties": {
          "values": {
            "items": {
              "format": "ipv6"
            }
          },
          "expected_values": {
            "items": {
              "format": "ipv6"
            }
          }
        }
      }
    }
  ]
}

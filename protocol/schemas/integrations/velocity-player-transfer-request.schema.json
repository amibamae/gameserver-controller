{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.13.0-draft:integrations:velocity-player-transfer-request",
  "title": "Velocity player transfer request",
  "description": "Transfer a specific, controller-selected cohort of proxy sessions to one confirmed-ready backend instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server_id",
    "environment_id",
    "source_backend_id",
    "destination_backend_id",
    "waiting_cohort_id",
    "expected_instance_ref",
    "readiness_assertion",
    "player_session_ids"
  ],
  "properties": {
    "server_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_backend_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "destination_backend_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "waiting_cohort_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expected_instance_ref": {
      "$ref": "urn:gameserver-controller:0.13.0-draft:common:external-resource-ref"
    },
    "readiness_assertion": {
      "$ref": "urn:gameserver-controller:0.13.0-draft:lifecycle:readiness-assertion"
    },
    "player_session_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}

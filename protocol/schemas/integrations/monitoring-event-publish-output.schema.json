{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:integrations:monitoring-event-publish-output",
  "title": "Monitoring event publish output",
  "description": "Delivery evidence for the exact event. Accepted indicates destination acknowledgment. Unknown indicates delivery could not be confirmed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "outcome", "observed_at"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{32}$"},
    "outcome": {"enum": ["accepted", "rejected", "outcome_unknown"]},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}

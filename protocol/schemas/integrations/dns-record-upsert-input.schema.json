{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:integrations:dns-record-upsert-input",
  "title": "DNS record upsert input",
  "description": "Set one managed record to explicit values for a declared purpose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record",
    "environment_id",
    "purpose",
    "values",
    "ttl_seconds"
  ],
  "properties": {
    "record": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:integrations:dns-record-target"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "purpose": {
      "enum": [
        "backend_address",
        "direct_join",
        "fallback"
      ]
    },
    "server_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "instance_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "readiness_assertion": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:lifecycle:readiness-assertion"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 45,
        "anyOf": [
          {
            "format": "ipv4"
          },
          {
            "format": "ipv6"
          }
        ]
      }
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "expected_values": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 45,
        "anyOf": [
          {
            "format": "ipv4"
          },
          {
            "format": "ipv6"
          }
        ]
      },
      "description": "Values the core expects the record to hold now; an empty array means the record is expected to be absent."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "enum": [
              "backend_address",
              "direct_join"
            ]
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "required": [
          "server_id",
          "instance_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "direct_join"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "required": [
          "readiness_assertion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "fallback"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "instance_ref"
              ]
            },
            {
              "required": [
                "readiness_assertion"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "record": {
            "properties": {
              "record_type": {
                "const": "A"
              }
            },
            "required": [
              "record_type"
            ]
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "properties": {
          "values": {
            "items": {
              "format": "ipv4"
            }
          },
          "expected_values": {
            "items": {
              "format": "ipv4"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record": {
            "properties": {
              "record_type": {
                "const": "AAAA"
              }
            },
            "required": [
              "record_type"
            ]
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "properties": {
          "values": {
            "items": {
              "format": "ipv6"
            }
          },
          "expected_values": {
            "items": {
              "format": "ipv6"
            }
          }
        }
      }
    }
  ]
}

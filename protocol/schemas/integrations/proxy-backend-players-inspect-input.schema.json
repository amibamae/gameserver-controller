{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:integrations:proxy-backend-players-inspect-input",
  "title": "Proxy backend player count inspect input",
  "description": "Request a count-only observation for one exact proxy backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "maximum_age_seconds"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:integrations:proxy-backend-target"
    },
    "maximum_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  }
}

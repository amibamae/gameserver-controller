{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:integrations:proxy-backend-players-inspect-output",
  "title": "Proxy backend player count inspect output",
  "description": "Count-only observation for one exact proxy backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "observation_state"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:integrations:proxy-backend-target"
    },
    "observation_state": {
      "enum": [
        "observed",
        "unknown"
      ]
    },
    "active_session_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation_state": {
            "const": "observed"
          }
        },
        "required": [
          "observation_state"
        ]
      },
      "then": {
        "required": [
          "active_session_count",
          "observed_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "observation_state": {
            "const": "unknown"
          }
        },
        "required": [
          "observation_state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "active_session_count"
              ]
            },
            {
              "required": [
                "observed_at"
              ]
            }
          ]
        }
      }
    }
  ]
}

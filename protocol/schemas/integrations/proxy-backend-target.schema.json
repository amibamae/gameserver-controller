{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.10.0-draft:integrations:proxy-backend-target",
  "title": "Proxy backend target",
  "description": "Backend name bound to one logical server, environment, and exact hosting instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server_id",
    "environment_id",
    "backend_id",
    "instance_ref"
  ],
  "properties": {
    "server_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "backend_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "instance_ref": {
      "$ref": "urn:gameserver-controller:0.10.0-draft:common:external-resource-ref"
    }
  }
}

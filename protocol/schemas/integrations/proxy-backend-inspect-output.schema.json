{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.12.0-draft:integrations:proxy-backend-inspect-output",
  "title": "Proxy backend inspect output",
  "description": "Observed routing state for one exact backend and instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "registration_state",
    "routability",
    "observed_at"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.12.0-draft:integrations:proxy-backend-target"
    },
    "registration_state": {
      "enum": [
        "registered",
        "draining",
        "unregistered",
        "unknown"
      ]
    },
    "routability": {
      "enum": [
        "routable",
        "not_routable",
        "unknown"
      ]
    },
    "active_session_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

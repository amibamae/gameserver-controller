{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.16.0-draft:integrations:proxy-backend-drain-output",
  "title": "Proxy backend drain output",
  "description": "Request acceptance is distinct from confirmation of the proxy's observed routing state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "request_outcome",
    "registration_state",
    "routability",
    "observed_at"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.16.0-draft:integrations:proxy-backend-target"
    },
    "request_outcome": {
      "enum": [
        "confirmed",
        "accepted",
        "rejected",
        "outcome_unknown"
      ]
    },
    "registration_state": {
      "enum": [
        "registered",
        "draining",
        "unregistered",
        "unknown"
      ]
    },
    "routability": {
      "enum": [
        "routable",
        "not_routable",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request_outcome": {
            "const": "confirmed"
          }
        },
        "required": [
          "request_outcome"
        ]
      },
      "then": {
        "properties": {
          "registration_state": {
            "const": "draining"
          },
          "routability": {
            "const": "not_routable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_outcome": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "request_outcome"
        ]
      },
      "then": {
        "properties": {
          "registration_state": {
            "const": "unknown"
          },
          "routability": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_outcome": {
            "const": "accepted"
          }
        },
        "required": [
          "request_outcome"
        ]
      },
      "then": {
        "properties": {
          "routability": {
            "enum": [
              "not_routable",
              "unknown"
            ]
          }
        }
      }
    }
  ]
}

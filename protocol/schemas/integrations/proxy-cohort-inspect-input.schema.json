{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:integrations:proxy-cohort-inspect-input",
  "title": "Proxy waiting cohort inspect input",
  "description": "List the opaque sessions currently waiting in one proxy-defined cohort on an exact proxy instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proxy_instance_ref",
    "waiting_cohort_id",
    "maximum_sessions",
    "maximum_observation_age_seconds"
  ],
  "properties": {
    "proxy_instance_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "waiting_cohort_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "maximum_sessions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maximum_observation_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    }
  }
}

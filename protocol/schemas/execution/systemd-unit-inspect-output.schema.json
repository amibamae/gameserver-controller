{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.11.0-draft:execution:systemd-unit-inspect-output",
  "title": "Systemd execution unit inspect output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_ref",
    "state",
    "observed_at"
  ],
  "properties": {
    "unit_ref": {
      "$ref": "urn:gameserver-controller:0.11.0-draft:common:external-resource-ref"
    },
    "state": {
      "enum": [
        "absent",
        "stopped",
        "starting",
        "running",
        "stopping",
        "failed",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_ref": {
      "type": "string",
      "maxLength": 500
    }
  }
}

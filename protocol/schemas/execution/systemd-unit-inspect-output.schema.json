{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:execution:systemd-unit-inspect-output",
  "title": "Systemd execution unit inspect output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_ref",
    "state",
    "observed_at"
  ],
  "properties": {
    "unit_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "state": {
      "enum": [
        "absent",
        "stopped",
        "starting",
        "running",
        "stopping",
        "failed",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_ref": {
      "type": "string",
      "maxLength": 500
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque identity of the current runtime incarnation. Adapters advertising restart must supply it while running; it changes after a completed restart."
    },
    "target": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:game:game-instance-target",
      "description": "Exact host binding, required with release_ref and runtime_id when the adapter advertises restart."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.11.0-draft:execution:systemd-unit-logs-read-input",
  "title": "Systemd execution unit logs read input",
  "description": "Read a bounded diagnostic window for one execution unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_ref",
    "max_bytes"
  ],
  "properties": {
    "unit_ref": {
      "$ref": "urn:gameserver-controller:0.11.0-draft:common:external-resource-ref"
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}

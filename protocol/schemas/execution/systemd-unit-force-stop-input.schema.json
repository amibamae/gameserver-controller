{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.15.0-draft:execution:systemd-unit-force-stop-input",
  "title": "Systemd execution unit force-stop input",
  "description": "Request an exceptional forced stop for an exact unit. The controller validates that approval is bound to this unit and reason before dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_ref",
    "approval_id",
    "reason_code"
  ],
  "properties": {
    "unit_ref": {
      "$ref": "urn:gameserver-controller:0.15.0-draft:common:external-resource-ref"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    }
  }
}

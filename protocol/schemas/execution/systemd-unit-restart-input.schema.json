{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:execution:systemd-unit-restart-input",
  "title": "Systemd execution unit restart input",
  "description": "Gracefully replace an exact running unit incarnation after a bound game save. A timeout never permits forced termination or blind replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_ref",
    "target",
    "release_id",
    "expected_runtime_id",
    "save_confirmation",
    "grace_period_seconds",
    "force",
    "save_step_id"
  ],
  "properties": {
    "unit_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:common:external-resource-ref"
    },
    "target": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:game:game-instance-target"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expected_runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "save_confirmation": {
      "allOf": [
        {
          "$ref": "urn:gameserver-controller:0.21.0-draft:game:save-request-output"
        },
        {
          "properties": {
            "outcome": {
              "const": "confirmed"
            }
          }
        }
      ]
    },
    "grace_period_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "force": {
      "const": false
    },
    "save_step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Completed game-save step in the same durable operation; its recorded output must equal save_confirmation."
    }
  }
}

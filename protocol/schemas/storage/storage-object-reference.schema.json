{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.8.0-draft:storage:storage-object-reference",
  "title": "Storage object reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "storage_profile_id",
    "environment_id",
    "container",
    "key"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "storage_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "container": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "description": "Exact storage object identity. version_id MUST be present when the provider exposes immutable object versions."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.16.0-draft:storage:object-put-output",
  "title": "Storage object put output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "upload_state",
    "observed_at"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.16.0-draft:storage:storage-object-target"
    },
    "upload_state": {
      "enum": [
        "uploaded",
        "not_uploaded",
        "unknown"
      ]
    },
    "object_ref": {
      "$ref": "urn:gameserver-controller:0.16.0-draft:storage:storage-object-reference"
    },
    "bytes_received": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provider_etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "upload_state": {
            "const": "uploaded"
          }
        },
        "required": [
          "upload_state"
        ]
      },
      "then": {
        "required": [
          "object_ref",
          "bytes_received"
        ]
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:storage:storage-transfer-reference",
  "title": "Bounded storage data transfer reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transfer_id",
    "direction",
    "maximum_bytes",
    "expires_at"
  ],
  "properties": {
    "transfer_id": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "description": "A controller-generated, unguessable 256-bit bearer capability encoded as 64 lowercase hexadecimal characters."
    },
    "direction": {
      "enum": [
        "controller_to_adapter",
        "adapter_to_controller"
      ]
    },
    "maximum_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Opaque, controller-issued, one-use, operation-scoped handle for a bounded byte stream. A transport binding maps it to the stream."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.21.0-draft:storage:object-list-output",
  "title": "Storage object list output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "container_ref",
    "items",
    "listing_state",
    "next_continuation_token",
    "observed_at"
  ],
  "properties": {
    "container_ref": {
      "$ref": "urn:gameserver-controller:0.21.0-draft:storage:storage-container-reference"
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_ref",
          "size_bytes"
        ],
        "properties": {
          "object_ref": {
            "$ref": "urn:gameserver-controller:0.21.0-draft:storage:storage-object-reference"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "provider_etag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "last_modified": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "listing_state": {
      "enum": [
        "complete",
        "truncated",
        "unknown"
      ]
    },
    "next_continuation_token": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "listing_state": {
            "const": "truncated"
          }
        },
        "required": [
          "listing_state"
        ]
      },
      "then": {
        "properties": {
          "next_continuation_token": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

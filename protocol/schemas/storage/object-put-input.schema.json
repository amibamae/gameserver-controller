{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.14.0-draft:storage:object-put-input",
  "title": "Storage object put input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "source_transfer",
    "expected_size_bytes",
    "expected_checksum"
  ],
  "properties": {
    "target": {
      "$ref": "urn:gameserver-controller:0.14.0-draft:storage:storage-object-target"
    },
    "source_transfer": {
      "allOf": [
        {
          "$ref": "urn:gameserver-controller:0.14.0-draft:storage:storage-transfer-reference"
        },
        {
          "type": "object",
          "required": [
            "direction"
          ],
          "properties": {
            "direction": {
              "const": "controller_to_adapter"
            }
          }
        }
      ]
    },
    "expected_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_checksum": {
      "$ref": "urn:gameserver-controller:0.14.0-draft:storage:storage-checksum"
    }
  }
}

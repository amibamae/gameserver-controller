{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.16.0-draft:storage:object-get-input",
  "title": "Storage object get input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_ref",
    "destination_transfer",
    "expected_size_bytes",
    "expected_checksum"
  ],
  "properties": {
    "object_ref": {
      "$ref": "urn:gameserver-controller:0.16.0-draft:storage:storage-object-reference"
    },
    "destination_transfer": {
      "allOf": [
        {
          "$ref": "urn:gameserver-controller:0.16.0-draft:storage:storage-transfer-reference"
        },
        {
          "type": "object",
          "required": [
            "direction"
          ],
          "properties": {
            "direction": {
              "const": "adapter_to_controller"
            }
          }
        }
      ]
    },
    "expected_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_checksum": {
      "$ref": "urn:gameserver-controller:0.16.0-draft:storage:storage-checksum"
    }
  }
}

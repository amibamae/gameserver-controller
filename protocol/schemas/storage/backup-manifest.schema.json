{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gameserver-controller:0.1.0-draft:storage:backup-manifest",
  "title": "Backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "backup_id", "server_id", "environment_id", "created_at", "source_operation_id", "game", "consistency", "objects"],
  "properties": {
    "manifest_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "backup_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "server_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "environment_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_instance_ref": {"$ref": "urn:gameserver-controller:0.1.0-draft:common:external-resource-ref"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "name", "version"],
      "properties": {
        "adapter_id": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": "string"},
        "world_format": {"type": "string"}
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "evidence"],
      "properties": {
        "mode": {"enum": ["offline", "game_native", "other"]},
        "evidence": {"type": "string", "maxLength": 2000}
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "size_bytes", "checksum_algorithm", "checksum"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "maxLength": 2048},
          "version_id": {"type": "string", "maxLength": 500},
          "size_bytes": {"type": "integer", "minimum": 0},
          "checksum_algorithm": {"enum": ["sha256"]},
          "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  }
}

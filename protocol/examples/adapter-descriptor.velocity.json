      "input_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-drain-input",
      "output_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-drain-output",
      "required_permissions": [
        "proxy.backend.manage"
      ]
    },
    {
      "name": "integration.proxy.backend.inspect",
      "version": "1",
      "mutating": false,
      "input_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-inspect-input",
      "output_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-inspect-output",
      "required_permissions": [
        "proxy.backend.manage"
      ]
    },
    {
      "name": "integration.proxy.backend.register",
      "version": "1",
      "mutating": true,
      "input_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-register-input",
      "output_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-register-output",
      "required_permissions": [
        "proxy.backend.manage"
      ]
    },
    {
      "name": "integration.proxy.backend.unregister",
      "version": "1",
      "mutating": true,
      "input_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-unregister-input",
      "output_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:proxy-backend-unregister-output",
      "required_permissions": [
        "proxy.backend.manage"
      ]
    },
    {
      "name": "integration.velocity.players.transfer",
      "version": "1",
      "mutating": true,
      "input_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:velocity-player-transfer-request",
      "output_schema_uri": "urn:gameserver-controller:0.14.0-draft:integrations:velocity-player-transfer-result",
      "required_permissions": [
        "proxy.backend.manage"
      ],
      "constraints": {
        "max_sessions_per_invocation": 100,
        "requires_current_readiness_assertion": true,
        "reconciliation_required_for_unknown_outcome": true

{
  "adapter_id": "game.minecraft-paper",
  "category": "game",
  "display_name": "Minecraft Paper game adapter",
  "implementation_version": "0.1.0",
  "protocol_versions": [
    "0.21.0-draft"
  ],
  "contract_versions": [
    "game.v1-draft"
  ],
  "required_permissions": [
    "game.configure",
    "game.install",
    "game.save",
    "game.release.inspect",
    "game.inspect",
    "runtime.inspect"
  ],
  "capabilities": [
    {
      "name": "game.configure",
      "version": "1",
      "mutating": true,
      "input_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:configure-input",
      "output_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:configure-output",
      "required_permissions": [
        "game.configure"
      ],
      "constraints": {
        "requires_release_pinned_configuration_schema": true,
        "validation_before_application": true
      }
    },
    {
      "name": "game.install",
      "version": "1",
      "mutating": true,
      "input_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:install-input",
      "output_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:install-output",
      "required_permissions": [
        "game.install"
      ],
      "constraints": {
        "verify_all_artifact_checksums_before_execution": true,
        "idempotent_for_same_release": true
      }
    },
    {
      "name": "game.readiness.check",
      "version": "1",
      "mutating": false,
      "input_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:readiness-check-input",
      "output_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:readiness-check-output",
      "required_permissions": [
        "runtime.inspect"
      ],
      "constraints": {
        "readiness_check_sets": [
          {
            "game_release_id": "paper-1.21.11-build-3",
            "environment_ids": [
              "staging"
            ],
            "readiness_check_set_id": "game.paper:paper-1.21.11:checks-v1",
            "required_checks": [
              {"check_id": "paper.startup-complete", "check_version": "1"},
              {"check_id": "paper.world-loaded", "check_version": "2"},
              {"check_id": "paper.players-joinable", "check_version": "1"}
            ]
          }
        ],
        "max_checks_per_request": 64,
        "unknown_check_result_blocks_readiness": true
      }
    },
    {
      "name": "game.save.request",
      "version": "1",
      "mutating": true,
      "input_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:save-request-input",
      "output_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:save-request-output",
      "required_permissions": [
        "game.save"
      ]
    },
    {
      "name": "game.release.describe",
      "version": "1",
      "mutating": false,
      "input_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:release-describe-input",
      "output_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:release-describe-output",
      "required_permissions": [
        "game.release.inspect"
      ]
    },
    {
      "name": "game.validate_installation",
      "version": "1",
      "mutating": false,
      "input_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:validate-installation-input",
      "output_schema_uri": "urn:gameserver-controller:0.21.0-draft:game:validate-installation-output",
      "required_permissions": [
        "game.inspect"
      ],
      "constraints": {
        "unknown_result_blocks_start": true
      }
    }
  ],
  "constraints": {
    "game": "Minecraft Java Edition",
    "server_software": "Paper"
  }
}

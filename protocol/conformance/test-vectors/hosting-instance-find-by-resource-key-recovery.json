  "purpose": "A lost create response is reconciled only from a complete exact-key lookup with one match; zero is inconclusive and duplicates require operator review.",
  "input": {
    "create_request": {
      "server_id": "server-staging",
      "environment_id": "staging",
      "resource_key": "gsc-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "region_id": "region-test",
      "plan_id": "plan-small",
      "os": {
        "provider_os_id": "debian-13",
        "distribution": "Debian",
        "version": "13",
        "architecture": "x86_64"
      }
    },
    "lookups": [
      {
        "case_id": "one-exact-match",
        "output": {
          "resource_key": "gsc-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "inventory_complete": true,
          "matches": [{
            "instance_ref": {"adapter_id":"hosting.example","environment_id":"staging","resource_kind":"instance","external_id":"vm-one"},
            "state": "creating"
          }],
          "observed_at": "2026-11-08T20:30:00Z"
        }
      },

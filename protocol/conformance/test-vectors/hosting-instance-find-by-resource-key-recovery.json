        "case_id": "zero-match-is-inconclusive",
        "output": {
          "resource_key": "gsc-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "inventory_complete": true,
          "matches": [],
          "observed_at": "2026-11-08T20:30:00Z"
        }
      },
      {
        "case_id": "duplicate-matches-require-operator",
        "output": {
          "resource_key": "gsc-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "inventory_complete": true,
          "matches": [
            {"instance_ref":{"adapter_id":"hosting.example","environment_id":"staging","resource_kind":"instance","external_id":"vm-one"},"state":"creating"},
            {"instance_ref":{"adapter_id":"hosting.example","environment_id":"staging","resource_kind":"instance","external_id":"vm-two"},"state":"creating"}
          ],
          "observed_at": "2026-11-08T20:30:00Z"
        }
      }
    ]
  },
  "expected": {
    "create_request_schema_valid": true,
    "lookups": [
      {"case_id":"one-exact-match","schema_valid":true,"match_count":1,"reconcile_as_created":true,"retry_create":false,"operator_review":false},
      {"case_id":"zero-match-is-inconclusive","schema_valid":true,"match_count":0,"reconcile_as_created":false,"retry_create":false,"operator_review":true},
      {"case_id":"duplicate-matches-require-operator","schema_valid":true,"match_count":2,"reconcile_as_created":false,"retry_create":false,"operator_review":true}

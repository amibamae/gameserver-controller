# Optional ONLY: do not install/enable until explicitly authorized.
# The service account needs read access to its pilot capacity DB.
[Unit]
Description=Optional GSC managed-only Homelable topology synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=minecraft-controller
EnvironmentFile=/etc/gsc-observability/homelable.env
LoadCredential=token:/etc/gsc-observability/homelable.jwt
ExecStart=/bin/sh /opt/gameserver-controller/scripts/observability/homelable_reconcile_once.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
MemoryMax=128M
CPUQuota=25%

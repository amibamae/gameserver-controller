[Unit]
Description=Conservative Minecraft recovery on %i
Documentation=https://github.com/amibamae/gameserver-controller/blob/main/docs/RECOVERY_POLICY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=minecraft-controller
Group=minecraft-controller
StateDirectory=gsc-paper-recovery
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/libexec/gsc/controller_recover.py --host %i --execute --confirm-host %i --state-dir /var/lib/gsc-paper-recovery
TimeoutStartSec=12min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/gsc-paper-recovery

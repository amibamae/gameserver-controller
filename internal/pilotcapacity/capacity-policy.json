{
  "policy_id": "supervised-pilot-vm-capacity",
  "policy_version": 4,
  "enforcement": {
    "mode": "runtime",
    "runtime_enforced": true,
    "reason": "The gsc-pilot provision command reserves capacity before Vultr create and reconciles uncertain outcomes."
  },
  "max_instances_total": 2,
  "ownership_scope": {
    "capacity_counts_only_controller_owned_instances": true,
    "unmanaged_production_may_remain_live": true,
    "production_adoption_is_optional": true,
    "provider_created_instances_are_controller_managed": true
  },
  "capacity_groups": {
    "production": {
      "max_instances": 1,
      "accepted_environments": [
        "production"
      ]
    },
    "shared_nonproduction": {
      "max_instances": 1,
      "accepted_environments": [
        "staging",
        "testing"
      ]
    }
  },
  "create_policy": {
    "reserve_slot_atomically_before_provider_create": true,
    "reservation_counts_as_capacity": true,
    "reject_duplicate_or_occupied_slot": true,
    "reject_if_total_would_exceed_limit": true,
    "reject_unsupported_environment": true,
    "occupancy": {
      "count_every_managed_instance_without_provider_confirmed_absence_or_destruction": true,
      "count_unresolved_create_outcome": true,
      "count_unresolved_destroy_outcome": true,
      "release_only_after_provider_confirmation": [
        "absent",
        "destroyed"
      ]
    }
  }
}
